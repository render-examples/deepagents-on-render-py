# Copy to .env and fill in real values. Never commit .env.

# --- Model provider (set at least one) ---------------------------------------
# Anthropic is used by default when set; override with LLM_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider when both keys are present ("anthropic" | "openai").
LLM_PROVIDER=
# Optional: override the default model id for the chosen provider.
# ANTHROPIC_MODEL=anthropic:claude-sonnet-4-6
# OPENAI_MODEL=openai:gpt-4o

# --- Postgres (LangGraph checkpointer + report store) ------------------------
# Render injects this automatically in production. For local dev, point it at
# your Postgres. "postgres://" URLs are normalized to "postgresql://".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepagents
# Connection pool sizing. Set max to your Postgres plan's connection limit
# divided across running instances (web + each Workflow).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=1

# --- Render Workflows (subagent execution backend) ---------------------------
# When set, subagents are dispatched to Render Workflows. When unset, they run
# in-process so the example works locally with no extra infrastructure.
RENDER_API_KEY=
# Name of the Workflow service you create in the Dashboard. The orchestrator
# addresses tasks as "<WORKFLOW_NAME>/research_agent".
WORKFLOW_NAME=deep-agents
# Optional escape hatch: force in-process subagents even if RENDER_API_KEY is set.
# WORKFLOWS_DISABLED=true

# --- API auth ----------------------------------------------------------------
# When set, all endpoints require this key via the X-API-Key header.
# Leave blank to run unauthenticated (dev only).
API_KEY=
