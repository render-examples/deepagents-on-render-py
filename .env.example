# Copy to .env and fill in real values. Never commit .env.

# Required: OpenAI key used by all LangChain agents.
OPENAI_API_KEY=sk-...

# Postgres connection string for trace storage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langchain_workflows

# Required in production: lets the API and orchestrator trigger Render
# Workflow tasks via the Render SDK.
RENDER_API_KEY=

# Recommended: when set, POST /reviews and the trace APIs require this key
# via the X-API-Key header. Leave blank to run the API unauthenticated (dev only).
REVIEW_API_KEY=
